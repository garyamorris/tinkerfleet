{
  "name": "tinkerfleet",
  "version": "0.1.0",
  "private": true,
  "description": "A small multi-agent workspace, explained from the ground up.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.local --import tsx src/server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lesson:0": "node --import tsx lessons/00-loop.ts",
    "lesson:1": "node --import tsx lessons/01-coordinator.ts",
    "lesson:2": "node --import tsx lessons/02-specialists.ts",
    "lesson:3": "node --import tsx lessons/03-tools.ts",
    "lesson:4": "node --import tsx lessons/04-approvals.ts",
    "lesson:5": "node --import tsx lessons/05-local-tools.ts",
    "lesson:6": "node --import tsx lessons/06-workspace.ts",
    "lesson:7": "node --import tsx lessons/07-your-tool.ts",
    "lesson:8": "node --import tsx lessons/08-sdk-approvals.ts",
    "lesson:9": "node --import tsx lessons/09-eval.ts",
    "lesson:10": "node --import tsx lessons/10-trace.ts",
    "lesson:11": "node --import tsx lessons/11-compare.ts",
    "lesson:12": "node --import tsx lessons/12-least-privilege.ts",
    "lesson:13": "node --import tsx lessons/13-schedules.ts",
    "eval": "node --env-file-if-exists=.env.local --import tsx evals/run.ts"
  },
  "dependencies": {
    "@openai/agents": "0.20.0",
    "openai": "7.34.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
