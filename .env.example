# Demo is the default and needs no key or model.
TINKERFLEET_MODE=demo

# Live chat: use an existing key in your secure server environment.
# TINKERFLEET_MODE=live
# TINKERFLEET_MODEL=your-tool-capable-model-id
# TINKERFLEET_REASONING_EFFORT=low
# OPENAI_API_KEY=

# Optional local tools: approved actions change REAL files in this folder.
# Commands run with your user permissions. This is not a sandbox.
# TINKERFLEET_WORKSPACE_TOOLS=1
# TINKERFLEET_WORKSPACE=/absolute/path/to/your/practice-project
# TINKERFLEET_PORT=4317

# This file is documentation. Never commit a real key or use VITE_ for secrets.
# See docs/setup.md for optional limits and startup instructions.
