# Demo is the default and needs no key, model, or Docker.
TINKERFLEET_MODE=demo

# Live mode is a deliberate opt-in and may incur API costs.
# Set these only in your own server environment. Never use VITE_ for secrets.
# TINKERFLEET_MODE=live
# TINKERFLEET_MODEL=your-tool-capable-model-id
# OPENAI_API_KEY=

# Optional server-only source: use one of these, not both.
# Default: examples/tiny-project.snapshot.json (portable, explicit file contents).
# TINKERFLEET_SNAPSHOT=/absolute/path/to/reviewed-project.snapshot.json
# Direct project-directory capture is Linux-only.
# TINKERFLEET_WORKSPACE=/absolute/path/to/a-small-synthetic-project
# TINKERFLEET_PORT=4317

# This file is documentation. See docs/setup.md for how to load a private copy.
# Tracing is disabled in the application. Never commit a real key.
