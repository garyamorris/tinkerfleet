# Tinkerfleet configuration worksheet — full explanation: docs/setup.md
# Copy to .env.local for your own settings. npm run dev and npm start load
# .env.local automatically. Restart the server after each change.

# 1. Explore the scripted app: no model, web requests, or project actions.
# Profiles, conversations, and memory notes still use real local app storage.
TINKERFLEET_MODE=demo

# 2. Connect a model when you want live replies. Replace MODE above with live.
# Supply a model available to your account and a key privately on the server.
# Never commit a real key or prefix it with VITE_ (which is browser-visible).
# Keep the key here rather than exporting it in your shell (see SECURITY.md).
# Choosing a model (docs/setup.md): a low-cost model such as gpt-6-luna is a good start.
# TINKERFLEET_MODEL=your-tool-capable-model-id
# OPENAI_API_KEY=
# TINKERFLEET_REASONING_EFFORT=low

# 3. Choose capabilities. Hosted public-web search is on in live mode;
# set 0 for conversation without web research. This does not drive your browser.
# TINKERFLEET_WEB_SEARCH=1

# Local tools are off by default. Set 1 to read a selected practice project
# and propose real edits/commands. Each edit and command needs exact approval.
# Commands use your OS permissions; selecting a folder does not sandbox them.
# With untrusted project text, also set TINKERFLEET_WEB_SEARCH=0 (SECURITY.md).
# TINKERFLEET_WORKSPACE_TOOLS=1
# TINKERFLEET_WORKSPACE=/absolute/path/to/your/practice-project
# TINKERFLEET_PORT=4317

# 4. Understand the budgets. Values below show defaults, not a spending promise.
# Turn and call counts: 0 means no cap. Token/output/runtime budgets stay active.
# Allowed ranges: docs/capabilities.md#run-budgets. Native commands have their
# own fixed timeout; these settings do not extend it.
# TINKERFLEET_MAX_TURNS=0
# TINKERFLEET_MAX_MODEL_CALLS=0
# TINKERFLEET_MAX_OUTPUT_TOKENS=2048
# TINKERFLEET_MAX_TOTAL_TOKENS=64000
# TINKERFLEET_MAX_RUN_MS=120000
